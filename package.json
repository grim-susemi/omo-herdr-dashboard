{
  "name": "omo-herdr-todo",
  "version": "0.1.0",
  "description": "Concurrent native Todo, DAG and worker surfaces for OmO inside Herdr.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "exports": {
    ".": "./dist/extension.mjs"
  },
  "files": [
    "bin/",
    "dist/",
    "LICENSE",
    "THIRD-PARTY-NOTICES.md",
    "README.md"
  ],
  "scripts": {
    "test": "node --test --test-isolation=none test/unit/*.test.mjs test/*.test.mjs",
    "test:host": "node scripts/test-host.mjs",
    "test:pty": "node scripts/qa-live.mjs",
    "qa:live": "node scripts/qa-live.mjs",
    "build": "node scripts/build.mjs",
    "check": "npm test && npm run build && npm run test:package",
    "test:package": "node scripts/verify-package.mjs",
    "prepack": "npm run build"
  },
  "keywords": [
    "omo",
    "senpi",
    "herdr",
    "todo",
    "dag",
    "tui"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/grim-susemi/omo-herdr-todo.git"
  },
  "private": false,
  "bin": {
    "omo-herdr-todo": "bin/omo-herdr-todo.mjs"
  }
}
